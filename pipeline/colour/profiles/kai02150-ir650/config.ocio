ocio_profile_version: 2.1

environment:
  {}
search_path: ""
strictparsing: true
luma: [0.2126, 0.7152, 0.0722]
name: ikonoskop-acam-dii-kai02150-ir650
description: |
  Ikonoskop A-Cam dII, colour profile candidate "kai02150-ir650" (A-Cam dII KAI-02150 sensor data (IR cut 650 nm)).
  Scene reference: ACES2065-1. Display reference: CIE XYZ D65.
  Generated by pipeline/colour/export_candidates.py; do not edit by hand.

roles:
  aces_interchange: ACES2065-1
  cie_xyz_d65_interchange: CIE-XYZ-D65
  color_timing: ACEScct
  compositing_log: ACEScct
  data: Raw
  default: ACES2065-1
  scene_linear: ACEScg

file_rules:
  - !<Rule> {name: Default, colorspace: ACES2065-1}

displays:
  sRGB - Display:
    - !<View> {name: ACES 1.0 - SDR Video, view_transform: ACES 1.0 - SDR Video, display_colorspace: sRGB - Display}
    - !<View> {name: Un-tone-mapped, view_transform: Un-tone-mapped, display_colorspace: sRGB - Display}
    - !<View> {name: Raw, colorspace: Raw}
  Rec.1886 Rec.709 - Display:
    - !<View> {name: ACES 1.0 - SDR Video, view_transform: ACES 1.0 - SDR Video, display_colorspace: Rec.1886 Rec.709 - Display}
    - !<View> {name: Un-tone-mapped, view_transform: Un-tone-mapped, display_colorspace: Rec.1886 Rec.709 - Display}
    - !<View> {name: Raw, colorspace: Raw}

active_displays: [sRGB - Display, Rec.1886 Rec.709 - Display]
active_views: [ACES 1.0 - SDR Video, Un-tone-mapped, Raw]

default_view_transform: Un-tone-mapped

view_transforms:
  - !<ViewTransform>
    name: ACES 1.0 - SDR Video
    description: ACES 1.0 Output Transform (RRT + SDR video ODT, 100 nits).
    from_scene_reference: !<BuiltinTransform> {style: ACES-OUTPUT - ACES2065-1_to_CIE-XYZ-D65 - SDR-VIDEO_1.0}

  - !<ViewTransform>
    name: Un-tone-mapped
    description: Colorimetric conversion only (Bradford ACES white to D65), no tone mapping.
    from_scene_reference: !<BuiltinTransform> {style: UTILITY - ACES-AP0_to_CIE-XYZ-D65_BFD}

display_colorspaces:
  - !<ColorSpace>
    name: CIE-XYZ-D65
    family: ""
    encoding: display-linear
    description: The CIE XYZ (D65) display connection colour space.
    isdata: false

  - !<ColorSpace>
    name: sRGB - Display
    family: Display
    encoding: sdr-video
    description: sRGB monitor (piecewise sRGB transfer function, Rec.709 primaries, D65).
    isdata: false
    from_display_reference: !<BuiltinTransform> {style: DISPLAY - CIE-XYZ-D65_to_sRGB}

  - !<ColorSpace>
    name: Rec.1886 Rec.709 - Display
    family: Display
    encoding: sdr-video
    description: Rec.709 video display (Rec.1886 gamma 2.4, Rec.709 primaries, D65).
    isdata: false
    from_display_reference: !<BuiltinTransform> {style: DISPLAY - CIE-XYZ-D65_to_REC.1886-REC.709}

colorspaces:
  - !<ColorSpace>
    name: ACES2065-1
    family: ACES
    encoding: scene-linear
    description: ACES2065-1, AP0 primaries, linear (the reference and interchange space).
    isdata: false

  - !<ColorSpace>
    name: ACEScg
    family: ACES
    encoding: scene-linear
    description: ACEScg, AP1 primaries, linear.
    isdata: false
    to_scene_reference: !<BuiltinTransform> {style: ACEScg_to_ACES2065-1}

  - !<ColorSpace>
    name: ACEScct
    family: ACES
    encoding: log
    description: ACEScct, AP1 primaries, log encoding for grading.
    isdata: false
    to_scene_reference: !<BuiltinTransform> {style: ACEScct_to_ACES2065-1}

  - !<ColorSpace>
    name: Raw
    family: Utility
    encoding: data
    description: Data, no colour conversion.
    isdata: true

  - !<ColorSpace>
    name: "A-Cam dII linear (kai02150-ir650, A white balance)"
    family: Input/Ikonoskop
    encoding: scene-linear
    description: |
      Ikonoskop A-Cam dII demosaiced linear camera RGB: black subtracted, 1.0 = white level
      (4095), white balanced for A (camera RGB divided by camera neutral
      [0.823813, 1.0, 0.443664]). Matrix from profile kai02150-ir650
      (A-Cam dII KAI-02150 sensor data (IR cut 650 nm)); same matrix as IDT.Ikonoskop.ACamdII.kai02150-ir650.A.ctl.
    isdata: false
    to_scene_reference: !<MatrixTransform> {matrix: [0.7166960358, 0.1637775680, 0.1195263962, 0.0000000000, -0.0969373508, 1.0703609751, 0.0265763757, 0.0000000000, 0.2233594292, -0.6952574492, 1.4718980200, 0.0000000000, 0.0000000000, 0.0000000000, 0.0000000000, 1.0000000000]}

  - !<ColorSpace>
    name: "A-Cam dII linear (kai02150-ir650, D65 white balance)"
    family: Input/Ikonoskop
    encoding: scene-linear
    description: |
      Ikonoskop A-Cam dII demosaiced linear camera RGB: black subtracted, 1.0 = white level
      (4095), white balanced for D65 (camera RGB divided by camera neutral
      [0.513034, 1.0, 0.871506]). Matrix from profile kai02150-ir650
      (A-Cam dII KAI-02150 sensor data (IR cut 650 nm)); same matrix as IDT.Ikonoskop.ACamdII.kai02150-ir650.D65.ctl.
    isdata: false
    to_scene_reference: !<MatrixTransform> {matrix: [0.7301395870, 0.3201655632, -0.0503051502, 0.0000000000, -0.0673200494, 1.2322781990, -0.1649581496, 0.0000000000, 0.1317098626, -0.4566055318, 1.3248956692, 0.0000000000, 0.0000000000, 0.0000000000, 0.0000000000, 1.0000000000]}

  - !<ColorSpace>
    name: "A-Cam dII linear (kai02150-ir650, D55 white balance)"
    family: Input/Ikonoskop
    encoding: scene-linear
    description: |
      Ikonoskop A-Cam dII demosaiced linear camera RGB: black subtracted, 1.0 = white level
      (4095), white balanced for D55 (camera RGB divided by camera neutral
      [0.549451, 1.0, 0.79276]). Matrix from profile kai02150-ir650
      (A-Cam dII KAI-02150 sensor data (IR cut 650 nm)); same matrix as IDT.Ikonoskop.ACamdII.kai02150-ir650.D55.ctl.
    isdata: false
    to_scene_reference: !<MatrixTransform> {matrix: [0.7282351061, 0.2980115838, -0.0262466899, 0.0000000000, -0.0715158035, 1.2093411525, -0.1378253490, 0.0000000000, 0.1446917097, -0.4904097321, 1.3457180225, 0.0000000000, 0.0000000000, 0.0000000000, 0.0000000000, 1.0000000000]}
