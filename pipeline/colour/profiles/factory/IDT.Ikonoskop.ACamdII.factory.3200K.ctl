// <ACEStransformID>urn:ampas:aces:transformId:v1.5:IDT.Ikonoskop.ACamdII.factory.3200K.a1.v1</ACEStransformID>
// <ACESuserName>ACES 1.0 Input - Ikonoskop A-Cam dII (factory, 3200 K white balance)</ACESuserName>
//
// Input Device Transform for the Ikonoskop A-Cam dII (Kodak KAI-02150 CCD, 12-bit CinemaDNG).
//
// Input:  demosaiced linear camera RGB, black level subtracted, normalised so that
//         1.0 = white level (4095), white balanced for 3200 K, i.e. each camera
//         channel divided by the camera neutral [0.931133, 1.0, 0.452595].
// Output: ACES2065-1 (AP0 primaries, linear). Balanced white (1,1,1) -> ACES (1,1,1);
//         no exposure scaling, no clipping.
// Profile: A-Cam dII factory matrices (D55 / 3200 K)
// White: 3200K, xy 0.42337 0.39896, CCT 3200 K,
//        DNG blend weight of matrix 1 = 0.0000
// Method: inverse ColorMatrix -> Bradford white to D50 -> Bradford D50 to ACES white -> XYZ to AP0
// Generated by pipeline/colour/export_candidates.py from profile.json; do not edit by hand.

const float B[3][3] = {
    { 0.7098652043, 0.2616147072, 0.0285200885 },
    { -0.0581158080, 1.2030875019, -0.1449716940 },
    { 0.1978591203, -0.4545789477, 1.2567198274 }
};

void main
(
    input varying float rIn,
    input varying float gIn,
    input varying float bIn,
    input varying float aIn,
    output varying float rOut,
    output varying float gOut,
    output varying float bOut,
    output varying float aOut
)
{
    rOut = B[0][0] * rIn + B[0][1] * gIn + B[0][2] * bIn;
    gOut = B[1][0] * rIn + B[1][1] * gIn + B[1][2] * bIn;
    bOut = B[2][0] * rIn + B[2][1] * gIn + B[2][2] * bIn;
    aOut = aIn;
}
